# 构建产物：只跟踪各游戏的「油管版」（build/<游戏>-yt/），其余一律不入库
/build/*
!/build/PlanetEaterEvolution-yt
/build/PlanetEaterEvolution-yt/*.zip
!/build/AntFlow-yt
!/build/WastelandSurvivor-yt
# 游戏目录里不跟踪打包 zip（可随时用 tools/build-<游戏>-yt.cjs --zip 重新生成）
/build/AntFlow-yt/*.zip
/build/WastelandSurvivor-yt/*.zip
# 诊断/普通 h5 构建的临时目录（也可以放到 %TEMP%\yt-diag，见 AGENTS.md）
/build/_scratch/

# 本地测试状态：报告、截图、日志、Chrome profile
/tools/state/

# 抓取下来的官方文档（体积大，需要时用 tools/fetch-docs.cjs 重新拉）
/.docs/

# 自签证书（本机生成，仅本地测试用）
/tools/certs/

# 临时文件
*.log
*.tmp

!/build/AirportSimulator3D-yt
/build/AirportSimulator3D-yt/*.zip
!/build/BeepMelody-yt
/build/BeepMelody-yt/*.zip
!/build/BobaBubbleTeaDIY-yt
/build/BobaBubbleTeaDIY-yt/*.zip
!/build/BubbleMerge-yt
/build/BubbleMerge-yt/*.zip
!/build/DogsVsAliens-yt
/build/DogsVsAliens-yt/*.zip

!/build/Dominators-yt
/build/Dominators-yt/*.zip
!/build/EggyCar-yt
/build/EggyCar-yt/*.zip
!/build/FallToRescue-yt
/build/FallToRescue-yt/*.zip
!/build/FindTheDifference-yt
/build/FindTheDifference-yt/*.zip
!/build/FloorPlanHomeDesign-yt
/build/FloorPlanHomeDesign-yt/*.zip

!/build/FlowerGardenBouquetSorting-yt
/build/FlowerGardenBouquetSorting-yt/*.zip
!/build/FruitCafeMatch3-yt
/build/FruitCafeMatch3-yt/*.zip
!/build/GardenSlide-yt
/build/GardenSlide-yt/*.zip
!/build/GoingBalls3D-yt
/build/GoingBalls3D-yt/*.zip
!/build/GrowIntoTheSun-yt
/build/GrowIntoTheSun-yt/*.zip

# 第四批已接 FB 游戏的 YouTube 产物
!build/HarvestIO-yt/
!build/HarvestIO-yt/**
build/HarvestIO-yt/*.zip
!build/JigsawCards-yt/
